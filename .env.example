# ─────────────────────────────────────────────────────────────────────────────
# Together Tasks — required env vars
# Copy to `.env.local` and fill in. Never commit the real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# From your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
# Service-role key — server-only — used for cross-user reads in the partner flows.
SUPABASE_SERVICE_ROLE_KEY=ey...

# App URL — base origin used for redirect links and push notifications.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI (Google Gemini) ───────────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ── Two-seat couple gate ─────────────────────────────────────────────────────
# Only these emails can sign in. The "Queen" routes through the love-verification
# gate after onboarding; the "King" goes straight to the dashboard.
NEXT_PUBLIC_KING_EMAIL=king@example.com
NEXT_PUBLIC_QUEEN_EMAIL=queen@example.com

# Display labels for the two roles (defaults to "King" / "Queen").
# Set these to personalise — e.g. "King Hatim", "Queen Pookie".
NEXT_PUBLIC_KING_LABEL=King
NEXT_PUBLIC_QUEEN_LABEL=Queen

# Optional: comma-separated handles the operator (king) might use; if a profile's
# username includes one, the UI shows "Love" instead of the raw handle.
NEXT_PUBLIC_KING_HANDLES=

# ── Geolocation (optional) ───────────────────────────────────────────────────
# Used for the "you're at home / at work" nudges. Replace with real coordinates.
NEXT_PUBLIC_WORK_LAT=0
NEXT_PUBLIC_WORK_LNG=0
NEXT_PUBLIC_WORK_RADIUS=200
NEXT_PUBLIC_HOME_LAT=0
NEXT_PUBLIC_HOME_LNG=0
NEXT_PUBLIC_HOME_RADIUS=100

# ── Web Push (optional) ──────────────────────────────────────────────────────
# Generate with: `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact mailto: URL the browser shows admins when push fails.
VAPID_CONTACT=mailto:admin@example.com
